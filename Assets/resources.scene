[scene]
name="resources"

[skyX]
type="//meworla/texture"
path="//novara/textures/sky/skyX.png"
[skyNX]
type="//meworla/texture"
path="//novara/textures/sky/skyNX.png"
[skyY]
type="//meworla/texture"
path="//novara/textures/sky/skyY.png"
[skyNY]
type="//meworla/texture"
path="//novara/textures/sky/skyNY.png"
[skyZ]
type="//meworla/texture"
path="//novara/textures/sky/skyZ.png"
[skyNZ]
type="//meworla/texture"
path="//novara/textures/sky/skyNZ.png"

[skytex]
type="//meworla/cubemap"
cubemap1="skyX"
cubemap2="skyNX"
cubemap3="skyY"
cubemap4="skyNY"
cubemap5="skyZ"
cubemap6="skyNZ"

# assets
[grass256]
type="//meworla/texture"
path="//novara/textures/terrain/grass256.png"

[brick256]
type="//meworla/texture"
path="//novara/textures/terrain/brick256.png"

[kies256]
type="//meworla/texture"
path="//novara/textures/terrain/kies256.png"

[dirt256]
type="//meworla/texture"
path="//novara/textures/terrain/dirt256.png"

[town_map]
type="//meworla/texture"
path="//novara/town/terrain/town_map.png"

[town_blend_map]
type="//meworla/texture"
path="//novara/town/terrain/town_blend_map.png"

[cube]
type="//meworla/mesh"
geometry="cube/cube_obj"
[cube/cube_obj]
type="//meworla/wavefront"
path="//novara/models/cube1/cube1.obj"
material="//novara/models/cube1/cube1.mtl"
diffuse_tex=("//novara/resources/grass")
[grass]
type="//meworla/texture"
path="//novara/models/cube1/textures/grass.jpg"

[wall]
type="//meworla/mesh"
geometry="wall/wall_obj"
[wall/wall_obj]
type="//meworla/wavefront"
path="//novara/town/models/wall/wall.obj"
material="//novara/town/models/wall/wall.mtl"
diffuse_tex=("//novara/resources/brick256")

[tavern_mesh]
type="//meworla/mesh"
geometry="tavern_mesh/tavernfloor"
[tavern_mesh/tavernfloor]
type="//meworla/wavefront"
path="//novara/town/models/tavern/tavernfloor.obj"
material="//novara/town/models/tavern/tavernfloor.mtl"
diffuse_tex=("//novara/resources/brick256")

[gnar]
type="//meworla/mesh"
geometry="gnar/obj"
[gnar/obj]
type="//meworla/wavefront"
path="//novara/models/gnar/gnar.obj"
material="//novara/models/gnar/gnar.mtl"
diffuse_tex=("//novara/resources/gnartex")

[gnartex]
type="//meworla/texture"
path="//novara/models/gnar/textures/gnartex.png"

[gus]
type="//meworla/mesh"
geometry="//novara/models/gus/gus_anim_walk.glb"
diffuse_tex=("//novara/resources/brick256")
[gusanimator]
type="//meworla/animator"
mesh="//novara/resources/gus"
initialState="idle"
autoplay=true
[gusanimator/idle]
type="//meworla/animationstate"
animation="IdleAction"
loop=true
[gusanimator/running]
type="//meworla/animationstate"
animation="RunningAction"
loop=true

[pier]
type="//meworla/mesh"
geometry="//novara/models/pier/pier.glb"

[impact]
type="//meworla/sound"
path="//novara/audio/impact.wav"

[snowfall]
type="//meworla/music"
path="//novara/audio/Snowfall_looped.ogg"

[harbour_map]
type="//meworla/texture"
path="//novara/harbour/terrain/harbour_map.png"

[harbour_blend_map]
type="//meworla/texture"
path="//novara/harbour/terrain/harbour_blend_map.png"

[water_normal]
type="//meworla/texture"
path="//novara/harbour/textures/water_normal.png"

[water]
type="//meworla/planemesh"
width=300
height=300
segmentsX=1
segmentsY=1
texture="//novara/resources/water_normal"
shader="//novara/resources/water_shader"
shadername="//novara/resources/water_shader"

#[water_material]
#type="//meworla/material"
#diffuse_tex=("//novara/resources/brick256")

[water_shader]
type="//meworla/shader"
name="water"
code_hlsl="//novara/shaders/water.hlsl"
code_glsl_vs="//novara/shaders/water_vs.glsl"
code_glsl_fs="//novara/shaders/water_fs.glsl"

input="standard"
light_type="vertex"
texture_type="standard"

alpha_blending=true
depth_test=true
depth_write=false
cull_mode="none"

[basin]
type="//meworla/planemesh"
width=300
height=300
segmentsX=1
segmentsY=1
uvScale=(300.0f, 300.0f)
texture="//novara/resources/dirt256"

[harbourgate]
type="//meworla/planemesh"
width=64
height=256
segmentsX=1
segmentsY=1
uvScale=(64.0f, 256.0f)
texture="//novara/resources/kies256"

[bighouse]
type="//meworla/cubemesh"
size=(10.0f,6.0f,20.0f)
texture="//novara/resources/brick256"
tileSize=(0.5f, 0.25f)

[step]
type="//meworla/cubemesh"
size=(10.0f,0.20f,2.0f)
texture="//novara/resources/brick256"
tileSize=(0.5f, 0.25f)

[fence]
type="//meworla/cubemesh"
size=(100.0f,2.0f,0.20f)
texture="//novara/resources/brick256"
tileSize=(0.5f, 0.25f)
